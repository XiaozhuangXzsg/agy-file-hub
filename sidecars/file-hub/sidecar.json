{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "env": {
    "AGY_FILE_HUB_VERSION": "1.0.0"
  },
  "restart_policy": "always",
  "display_name": "File Hub",
  "description": "按项目与会话分类管理 Antigravity 所有文件，支持分类、排序、预览、在线编辑、详情查看与在资源管理器中打开。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "File Hub",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "File Hub"
      }
    ]
  }
}
